# HETA Kalkulationsassistent – Beispielkonfiguration
# Kopieren nach ".env" und anpassen. Keine API-Keys in den Quellcode schreiben!

# Datenverzeichnis (SQLite-Datenbank, Einstellungen, Backups)
HETA_DATA_DIR=./data
# Optional: abweichender Datenbankpfad
# HETA_DB_PATH=./data/heta_kalkulation.db

# Basisverzeichnis der Angebote (kann auch in der Oberfläche gesetzt werden)
# HETA_BASE_DIR=\\SERVER\Freigabe\Angebote

# --- Optionale KI-Anbindung (standardmäßig AUS) ---
# none | mock | ollama | azure_foundry | m365_copilot
HETA_AI_PROVIDER=none
# Externe Übertragung muss ausdrücklich erlaubt werden (true/false)
HETA_AI_EXTERNAL_ENABLED=false
HETA_AI_TIMEOUT_SECONDS=60

# Ollama (lokal)
# HETA_OLLAMA_URL=http://127.0.0.1:11434
# HETA_OLLAMA_MODEL=llama3.1

# Microsoft Foundry / Azure AI (nur mit geprüfter Konfiguration)
# HETA_AZURE_ENDPOINT=https://<ressource>.services.ai.azure.com/models
# HETA_AZURE_DEPLOYMENT=<deployment-name>
# HETA_AZURE_API_KEY=<nur in .env, niemals einchecken>
# HETA_AZURE_API_VERSION=2024-05-01-preview
